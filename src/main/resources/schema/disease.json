{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "visible": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "uri": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "filteredAnecdotes": {
      "type": "array",
      "items": [
        {
          "type": "string"
        }
      ]
    },
    "carnivoreDietSearchQueries": {
      "type": "array",
      "items": [
        {
          "type": "string"
        }
      ]
    },
    "anecdotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "visible": {
            "type": "boolean"
          },
          "uri": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "text"
      ]
    },
    "see": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "uri",
        "name"
      ]
    },
    "papers": {
      "type": "array",
      "items": [
        {
          "type": "string"
        }
      ]
    },
    "articles": {
      "type": "array",
      "items": [
        {
          "type": "string"
        }
      ]
    },
    "videos": {
      "type": "array",
      "items": [
        {
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "visible",
    "name",
    "uri"
  ]
}