<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{{ title }} - Plants Cause Disease</title>
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; margin: 2rem 4rem; line-height: 1.6; color: #222; max-width: 60em; }
        h1 { color: #2c5530; }
        blockquote { border-left: 4px solid #2c5530; padding-left: 1rem; margin: 1rem 0; color: #444; font-style: italic; }
        a { color: #2c5530; }
        .source { color: #666; font-size: 0.9rem; }
        .section { margin-top: 1.5rem; }
        .section h2 { font-size: 1.2rem; color: #2c5530; border-bottom: 1px solid #ddd; padding-bottom: 0.3rem; }
        ul { padding-left: 1.5rem; }
        .anecdote { margin-bottom: 0.5rem; }
        .anecdote .date { color: #888; font-size: 0.85rem; }
        footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #ddd; color: #666; font-size: 0.9rem; }
        nav { margin-bottom: 1.5rem; }
        nav a { margin-right: 1rem; }
    </style>
</head>
<body>
<nav><a href="/index.html">All diseases</a></nav>
<h1>{{ title }}</h1>

{% if definition is not null and definition is not empty %}
<p>Definition{% if source_uri is not empty and source_name is not null %} by <a href="{{ source_uri }}">{{ source_name }}</a>{% endif %}:</p>
<blockquote>{{ definition }}</blockquote>
{% endif %}

{% if see_uri is not null %}
<p>see <a href="/disease/{{ see_uri }}.html">{{ see_name }}</a>.</p>
{% endif %}

{% if text is not null %}
<div class="section">
    <h2>Description</h2>
    <p>{{ text }}</p>
</div>
{% endif %}

{% if anecdotes is not null and anecdotes is not empty %}
<div class="section">
    <h2>Anecdotes</h2>
    <ul>
    {% for a in anecdotes %}
        <li class="anecdote"><a href="{{ a.uri }}">{{ a.title }}</a> <span class="date">({{ a.date }})</span></li>
    {% endfor %}
    </ul>
</div>
{% endif %}

{% if filteredAnecdotes is not null and filteredAnecdotes is not empty %}
<div class="section">
    <h2>Filtered anecdotes</h2>
    <ul>
    {% for u in filteredAnecdotes %}
        <li><a href="{{ u }}">{{ u }}</a></li>
    {% endfor %}
    </ul>
</div>
{% endif %}

{% if papers is not null and papers is not empty %}
<div class="section">
    <h2>Papers</h2>
    <ul>
    {% for p in papers %}
        <li>{{ p }}</li>
    {% endfor %}
    </ul>
</div>
{% endif %}

{% if articles is not null and articles is not empty %}
<div class="section">
    <h2>Articles</h2>
    <ul>
    {% for a in articles %}
        <li>{{ a }}</li>
    {% endfor %}
    </ul>
</div>
{% endif %}

{% if videos is not null and videos is not empty %}
<div class="section">
    <h2>Videos</h2>
    <ul>
    {% for v in videos %}
        <li>{{ v }}</li>
    {% endfor %}
    </ul>
</div>
{% endif %}

<footer>Plants Cause Disease</footer>
</body>
</html>
